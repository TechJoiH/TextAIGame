    iconSprite: {fileID: 0}
    allowedSceneId: loc_zhaoyao
    templateDescription: 剑身布满绿锈的残兵，仍保留着最基础的杀伤力。
  - templateId: cloth_headband
    displayName: 缚风头带
    itemKind: 1
    equipSlot: 1
    stackable: 0
    iconPath: Item/windhead
    iconSprite: {fileID: 0}
    allowedSceneId: loc_zhaoyao
    templateDescription: 以旧布缠成的头带，能束住乱发，也能让人在山风里稳住心神。
  - templateId: traveler_robe
    displayName: 行山短褐
